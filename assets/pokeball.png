<svg width="32" height="32" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
  <style>
    .pixel { shape-rendering: crispEdges; }
  </style>
  
  <!-- Outer circle - Red top -->
  <rect class="pixel" x="8" y="4" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="12" y="4" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="16" y="4" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="20" y="4" width="4" height="4" fill="#000000"/>
  
  <rect class="pixel" x="4" y="8" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="8" y="8" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="12" y="8" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="16" y="8" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="20" y="8" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="24" y="8" width="4" height="4" fill="#000000"/>
  
  <rect class="pixel" x="4" y="12" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="8" y="12" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="12" y="12" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="16" y="12" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="20" y="12" width="4" height="4" fill="#FF0000"/>
  <rect class="pixel" x="24" y="12" width="4" height="4" fill="#000000"/>
  
  <!-- Middle line - Black separator -->
  <rect class="pixel" x="4" y="16" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="8" y="16" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="12" y="16" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="16" y="16" width="4" height="4" fill="#FFFFFF"/>
  <rect class="pixel" x="20" y="16" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="24" y="16" width="4" height="4" fill="#000000"/>
  
  <!-- Bottom half - White -->
  <rect class="pixel" x="4" y="20" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="8" y="20" width="4" height="4" fill="#FFFFFF"/>
  <rect class="pixel" x="12" y="20" width="4" height="4" fill="#FFFFFF"/>
  <rect class="pixel" x="16" y="20" width="4" height="4" fill="#FFFFFF"/>
  <rect class="pixel" x="20" y="20" width="4" height="4" fill="#FFFFFF"/>
  <rect class="pixel" x="24" y="20" width="4" height="4" fill="#000000"/>
  
  <rect class="pixel" x="8" y="24" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="12" y="24" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="16" y="24" width="4" height="4" fill="#000000"/>
  <rect class="pixel" x="20" y="24" width="4" height="4" fill="#000000"/>
</svg>
